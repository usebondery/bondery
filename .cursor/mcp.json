{
  "mcpServers": {
    "bondery": {
      "url": "https://api.usebondery.test/mcp"
    },
    "chrome-devtools": {
      "command": "pnx -y chrome-devtools-mcp@latest"
    },
    "dashboard-icons": {
      "url": "https://dashboardicons.com/api/mcp"
    },
    "expo": {
      "url": "https://mcp.expo.dev/mcp"
    },
    "plane": {
      "args": [
        "${workspaceFolder}/scripts/dev/plane-mcp-stdio.mjs"
      ],
      "command": "node",
      "type": "stdio"
    },
    "uniwind": {
      "url": "https://docs.uniwind.dev/mcp"
    },
    "vercel": {
      "note": "Official Vercel MCP server. Uses OAuth — on first connection the agent will be prompted to authorize via Vercel. Read-only in initial release: search docs, list projects/deployments, inspect logs.",
      "url": "https://mcp.vercel.com"
    }
  }
}
