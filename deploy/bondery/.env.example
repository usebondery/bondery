# =============================================================================
# Bondery stack — copy to .env and fill secrets
# Generated by pnpm run env — do not edit by hand. Edit packages/helpers/src/env/manifest.ts.
# docker compose -f deploy/bondery/docker-compose.yml --env-file deploy/bondery/.env up -d
# =============================================================================

# --- Public hostnames ---
# Traefik Host() rules use these; Compose derives https://… URLs for the apps (no scheme here).
BONDERY_INFRA_API_DOMAIN=api.usebondery.com
BONDERY_INFRA_CHROME_EXTENSION_ID=lpcmokfekjjejnpobhbkgmjkodfhpmha
BONDERY_INFRA_WEBAPP_DOMAIN=app.usebondery.com
BONDERY_INFRA_WEBSITE_DOMAIN=usebondery.com

# --- Redis ---
# Bundled Redis (default). Advanced: run API alone with a managed Redis URL.
BONDERY_PRIVATE_REDIS_URL=redis://redis:6379

# --- Postgres ---
# Generate:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32   # BONDERY_PRIVATE_POSTGRES_PASSWORD
# Compose builds DATABASE_URL from this password — do not set DATABASE_URL in .env.
# Compose publishes Postgres on 127.0.0.1 only (SSH tunnels). Default host port 5432; a second stack on the same VPS must set BONDERY_INFRA_POSTGRES_HOST_PORT (beta: 5433).
# BONDERY_INFRA_POSTGRES_HOST_PORT=5432
BONDERY_PRIVATE_POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# --- Better Auth ---
# Generate local secrets (not issued by GitHub/LinkedIn):
#   openssl rand -hex 32   # BONDERY_PRIVATE_BETTER_AUTH_SECRETS → set as 1:<output>
#   openssl rand -hex 32   # BONDERY_PRIVATE_SERVICE_SECRET
#
# GitHub / LinkedIn OAuth apps: callback URL on the API host (not the webapp):
#   https://<BONDERY_INFRA_API_DOMAIN>/auth/callback/github  (or /linkedin)
# OAuth clients are provisioned automatically on api pre_start (release-migrate).
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_ID=""
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_SECRET=""
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_ID=""
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_SECRET=""
BONDERY_PRIVATE_BETTER_AUTH_SECRETS=1:your-super-secret-better-auth-secret-min-32-chars
BONDERY_PRIVATE_SERVICE_SECRET=your-service-secret-min-32-chars
# BONDERY_PUBLIC_WEBAUTHN_RP_ID=""

# --- Webapp OAuth ---
# Generate:
#   openssl rand -hex 16   # BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_SESSION_SECRET
# Passed to the webapp container via compose environment (BFF OAuth session).
BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET=your-super-secret-webapp-oauth-client-secret-min-32-chars
BONDERY_PRIVATE_WEBAPP_SESSION_SECRET=your-super-secret-webapp-session-secret-min-32-chars
BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID=your-webapp-oauth-client-id

# --- Chrome extension OAuth ---
# Generate: openssl rand -hex 16   # BONDERY_PUBLIC_OAUTH_CLIENT_ID
BONDERY_PUBLIC_OAUTH_CLIENT_ID=""

# --- Storage ---
# S3 credentials are rendered into SeaweedFS at container start (see deploy/bondery/seaweedfs/entrypoint.sh).
# Production secret key: openssl rand -hex 32   # BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY
BONDERY_INFRA_STORAGE_DOMAIN=storage.usebondery.com
BONDERY_PRIVATE_S3_ACCESS_KEY_ID=bondery_access_key
BONDERY_PRIVATE_S3_ENDPOINT=http://seaweedfs-s3:8333
BONDERY_PRIVATE_S3_REGION=eu-central-1
BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY=bondery_secret_key_change_me
BONDERY_PUBLIC_STORAGE_URL=https://storage.usebondery.com

# --- Email ---
# SMTP settings (env_file → api only).
BONDERY_PRIVATE_EMAIL_ADDRESS=robot@usebondery.com
BONDERY_PRIVATE_EMAIL_HOST=smtp.example.com
BONDERY_PRIVATE_EMAIL_PASS=your-email-password
BONDERY_PRIVATE_EMAIL_PORT=587
BONDERY_PRIVATE_EMAIL_REPLY_TO=team@usebondery.com
BONDERY_PRIVATE_EMAIL_USER=username

# --- Stripe ---
# Stripe live-mode placeholders — replace with Dashboard values.
BONDERY_PRIVATE_STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
BONDERY_PRIVATE_STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>
BONDERY_PUBLIC_BILLING_UPGRADES_ENABLED=false
BONDERY_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_<annual>
BONDERY_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_<monthly>
BONDERY_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_<your-stripe-publishable-key>

# --- Optional integrations (API) ---
BONDERY_PRIVATE_ANTHROPIC_API_KEY=""
BONDERY_PRIVATE_MAPS_KEY=""
BONDERY_PUBLIC_MAPS_URL=https://api.mapy.com

# --- Optional webapp analytics ---
BONDERY_PUBLIC_POSTHOG_HOST=""
BONDERY_PUBLIC_POSTHOG_KEY=""

# --- Build metadata ---
BONDERY_INFRA_GIT_SHA=""

# --- Image pin ---
# Omit BONDERY_INFRA_VERSION on production to pull :production, or pin X.Y.Z. Staging may pin a named RC or :beta (RC cuts only). RC is not a self-host channel.
# BONDERY_INFRA_TRAEFIK_PREFIX defaults to bondery. Infisical staging: bondery-beta. Infisical production: bondery or omit.
BONDERY_INFRA_TRAEFIK_PREFIX=bondery
# BONDERY_INFRA_VERSION=1.9.2

