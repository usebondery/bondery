# Generated by pnpm run env — do not edit by hand. Edit root .env.local instead.

# --- Analytics ---
# PostHog host URL (browser and server capture)
BONDERY_PUBLIC_POSTHOG_HOST=""
# PostHog project API key (browser and server capture)
BONDERY_PUBLIC_POSTHOG_KEY=""
# Disable analytics / vendor telemetry when true
DO_NOT_TRACK=true

# --- Auth ---
# Local secrets you invent (not issued by GitHub/LinkedIn):
#   openssl rand -hex 32   # BONDERY_PRIVATE_BETTER_AUTH_SECRETS → set as 1:<output>
#   openssl rand -hex 16   # BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET
#   openssl rand -hex 16   # BONDERY_PUBLIC_OAUTH_CLIENT_ID (chrome extension)
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_SESSION_SECRET
#
# GitHub / LinkedIn OAuth apps: callback URL must be on the API host (not the webapp):
#   <BONDERY_PUBLIC_API_URL>/auth/callback/github  (or /linkedin)
#   Local Portless: https://api.usebondery.test/auth/callback/github
#   Classic escape hatch: http://localhost:26631/auth/callback/github
#   Then run: pnpm run provision:oauth-clients
# Webapp's own OAuth client secret (never exposed to the browser). The API only ever stores/verifies its hash via deployment-time provisioning; it never round-trips the plaintext value.
# Generate: openssl rand -hex 32
BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET=""
# Symmetric key (≥32 chars) for encrypting the webapp's own session cookie
# Generate: openssl rand -hex 32
BONDERY_PRIVATE_WEBAPP_SESSION_SECRET=your-super-secret-webapp-session-secret-min-32-chars
# Webapp's own OAuth client id (confidential BFF client of the API's oauth-provider)
# Generate: openssl rand -hex 16
BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID=""

# --- Feature flags ---
# REMOVED. Trusted Types is always report-only and needs no registered policy. This variable has no effect and is kept only so an existing deployment value does not fail the env check.
BONDERY_PUBLIC_CSP_TRUSTED_TYPES=""

# --- Infra ---
# Git SHA surfaced in runtime config and health probes
BONDERY_INFRA_GIT_SHA=""
# Webapp SSR/BFF API base URL (loopback or Compose DNS). Browser clients keep using BONDERY_PUBLIC_API_URL.
BONDERY_INFRA_INTERNAL_API_URL=""
# Image tag for api and webapp: production CalVer pin (X.Y.Z), or omit for floating `:production`. Staging Dokploy may pin a named RC (`X.Y.Z-rc.N`) or floating `:beta` (RC cuts only). RC is not a self-host channel.
BONDERY_INFRA_VERSION=""

# --- Public URLs ---
# Local web stack uses Portless HTTPS (website/webapp/api).
# Webapp SSR: set BONDERY_INFRA_INTERNAL_API_URL=http://127.0.0.1:26631 (browser still uses the public API URL).
# Public API base URL (no trailing /api)
BONDERY_PUBLIC_API_URL=https://api.usebondery.com
# Send CSP violation reports to `${BONDERY_PUBLIC_API_URL}/security/csp-report` (true | false). Default on. A self-host install set `false` to send no reports. The endpoint is derived from the API URL, so it cannot disagree with the API it posts to.
BONDERY_PUBLIC_CSP_REPORT_ENABLED=true
# Public webapp origin
BONDERY_PUBLIC_WEBAPP_URL=https://app.usebondery.com
# Public marketing website origin
BONDERY_PUBLIC_WEBSITE_URL=https://usebondery.com

# --- Storage ---
# Local dev: bundled SeaweedFS defaults below are fine.
# Production secret key: openssl rand -hex 32   # BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY
# Public base URL for SeaweedFS S3 objects (no trailing slash).
BONDERY_PUBLIC_STORAGE_URL=http://127.0.0.1:8333

# --- Stripe ---
# Enable in-app subscription upgrades (true | false)
BONDERY_PUBLIC_BILLING_UPGRADES_ENABLED=false
# Stripe publishable key for embedded Checkout
BONDERY_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

