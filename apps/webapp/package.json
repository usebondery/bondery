  "description": "Bondery Webapp",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "name": "webapp",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:analytics-events": "tsx scripts/check-analytics-events.ts",
    "check:api-fetch": "tsx scripts/check-api-fetch.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:modal-patterns": "tsx scripts/check-modal-patterns.ts",
    "check:schemas-imports": "tsx scripts/check-schemas-imports.ts",
    "check:theme-patterns": "tsx scripts/check-theme-patterns.ts",
    "check:types": "next typegen && node ../../scripts/dev/tsc-native.mjs --noEmit && node ../../scripts/dev/tsc-native.mjs --noEmit -p e2e && pnpm run check:analytics-events && pnpm run check:api-fetch && pnpm run check:modal-patterns && pnpm run check:schemas-imports && pnpm run check:theme-patterns",
    "copy-maplibre-worker": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "node ../../scripts/dev/portless-alias.mjs webapp && pnpm run dev:next",
    "dev:classic": "next dev --port 26632",
    "dev:next": "next dev --port 26632",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "hero-shot": "playwright test -c e2e/hero-shot.playwright.config.mjs",
    "prebuild": "cross-env NODE_ENV=production pnpm run generate-icons && pnpm run copy-maplibre-worker",
    "predev": "node ../../scripts/dev/kill-webapp-dev.mjs && cross-env NODE_ENV=development pnpm run generate-icons && pnpm run copy-maplibre-worker",
    "predev:classic": "node ../../scripts/dev/kill-webapp-dev.mjs && cross-env NODE_ENV=development pnpm run generate-icons && pnpm run copy-maplibre-worker",
    "smoke-ssr": "node scripts/smoke-ssr-boot.mjs",
    "start": "next start",
    "store-shots": "pnpm dlx --package @playwright/test@1.62.1 playwright test -c e2e/store-shots.playwright.config.mjs",
    "test:auth": "tsx --test src/lib/auth/*.test.ts src/lib/auth/reconfirm/*.test.ts",
    "test:availability": "tsx --test src/lib/api/availabilityStore.test.ts src/lib/api/applyTransportErrorPolicy.test.ts src/lib/api/health.test.ts src/lib/api/resolveServerApiUrl.test.ts src/lib/api/isMissingContactError.test.ts src/lib/api/resources/subscription.test.ts",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:auth-setup": "node scripts/run-playwright.mjs --project=setup",
    "test:e2e:debug": "node scripts/run-playwright.mjs --debug",
    "test:e2e:github": "node scripts/run-playwright.mjs --project=github-login",
    "test:e2e:install": "node scripts/install-playwright-browser.mjs",
    "test:e2e:install-deps": "node scripts/install-playwright-deps.mjs",
    "test:merge": "tsx --test src/lib/merge/*.test.ts",
    "test:proxy": "node --conditions=react-server --import tsx --test src/lib/security/proxy.test.ts",
    "test:runtime-config": "tsx --test src/lib/platform/runtimeConfig.server.test.ts src/lib/platform/internalApiTls.server.test.ts",
    "test:shell": "tsx --test src/components/shell/*.test.ts",
    "test:speech": "tsx --test src/lib/speech/*.test.ts src/lib/speech/dictation/*.test.ts",
    "test:sync": "tsx --test src/lib/sync/sync-wake-client.test.ts",
    "test:theme": "tsx --test src/lib/theme/theme.test.ts"
  },
  "type": "module",
  "version": "1.11.5-rc.2"
}
