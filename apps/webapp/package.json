  "description": "Bondery Webapp",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.24",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "name": "webapp",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:analytics-events": "tsx scripts/check-analytics-events.ts",
    "check:api-fetch": "tsx scripts/check-api-fetch.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:modal-patterns": "tsx scripts/check-modal-patterns.ts",
    "check:schemas-imports": "tsx scripts/check-schemas-imports.ts",
    "check:theme-patterns": "tsx scripts/check-theme-patterns.ts",
    "check:types": "node ../../scripts/dev/tsc-native.mjs --noEmit && pnpm run check:analytics-events && pnpm run check:api-fetch && pnpm run check:modal-patterns && pnpm run check:schemas-imports && pnpm run check:theme-patterns",
    "dev": "next dev --port 26632",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "prebuild": "cross-env NODE_ENV=production pnpm run generate-icons",
    "predev": "node ../../scripts/dev/kill-webapp-dev.mjs && cross-env NODE_ENV=development pnpm run generate-icons",
    "smoke-ssr": "node scripts/smoke-ssr-boot.mjs",
    "start": "next start",
    "store-shots": "pnpm dlx --package @playwright/test@1.62.1 playwright test -c e2e/store-shots.playwright.config.mjs",
    "test:auth": "tsx --test src/lib/auth/*.test.ts src/lib/auth/reconfirm/*.test.ts",
    "test:availability": "tsx --test src/lib/api/availabilityStore.test.ts src/lib/api/applyTransportErrorPolicy.test.ts src/lib/api/health.test.ts src/lib/api/resolveServerApiUrl.test.ts src/lib/api/isMissingContactError.test.ts",
    "test:merge": "tsx --test src/lib/merge/*.test.ts",
    "test:runtime-config": "tsx --test src/lib/platform/runtimeConfig.server.test.ts",
    "test:sync": "tsx --test src/lib/sync/sync-wake-client.test.ts",
    "test:theme": "tsx --test src/lib/theme/theme.test.ts"
  },
  "type": "module",
  "version": "1.10.2-rc.1"
}
