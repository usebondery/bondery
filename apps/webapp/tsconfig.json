{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "typecheck-experiments", "e2e", ".next/dev"],
  "extends": "@bondery/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/translations/src/generated/i18next-cli/i18next.d.ts"
  ]
}
