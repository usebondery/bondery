{
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    // Force one Fastify module identity so plugin augmentations
    // (@fastify/swagger, multipart, websocket, rate-limit) apply under
    // nodeLinker: isolated + enableGlobalVirtualStore.
    "paths": {
      "fastify": ["./node_modules/fastify"],
      "fastify/*": ["./node_modules/fastify/*"]
    },
    "rootDir": "./src",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "extends": "@bondery/typescript-config/base.json",
  "include": ["src/**/*"]
}
