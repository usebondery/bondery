# Generated by pnpm run env — do not edit by hand. Edit root .env.local instead.

# --- AI ---
# Anthropic API key for AI features
BONDERY_PRIVATE_ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>

# --- Analytics ---
# PostHog host URL (browser and server capture)
BONDERY_PUBLIC_POSTHOG_HOST=""
# PostHog project API key (browser and server capture)
BONDERY_PUBLIC_POSTHOG_KEY=""
# Disable analytics / vendor telemetry when true
DO_NOT_TRACK=true

# --- API secrets ---
# Generate:
#   openssl rand -hex 32   # BONDERY_PRIVATE_SERVICE_SECRET
# Comma-separated operator emails promoted to user.role=admin by provision-platform-admins at deploy
BONDERY_PRIVATE_PLATFORM_ADMIN_EMAILS=ops@example.com
# Optional break-glass comma-separated user UUIDs with platform admin access (Better Auth adminUserIds)
BONDERY_PRIVATE_PLATFORM_ADMIN_USER_IDS=""
# Internal service-to-service HMAC secret
# Generate: openssl rand -hex 32
BONDERY_PRIVATE_SERVICE_SECRET=<your-service-secret>

# --- Auth ---
# Local secrets you invent (not issued by GitHub/LinkedIn):
#   openssl rand -hex 32   # BONDERY_PRIVATE_BETTER_AUTH_SECRETS → set as 1:<output>
#   openssl rand -hex 16   # BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET
#   openssl rand -hex 16   # BONDERY_PUBLIC_OAUTH_CLIENT_ID (chrome extension)
#   openssl rand -hex 32   # BONDERY_PRIVATE_WEBAPP_SESSION_SECRET
#
# GitHub / LinkedIn OAuth apps: callback URL must be on the API host (not the webapp):
#   <BONDERY_PUBLIC_API_URL>/auth/callback/github  (or /linkedin)
#   Local example: http://localhost:26631/auth/callback/github
#   Then run: pnpm run provision:oauth-clients
# GitHub OAuth client id for Better Auth (from GitHub → Settings → Developer settings → OAuth apps)
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_ID=""
# GitHub OAuth client secret for Better Auth (shown once when you create the OAuth app)
BONDERY_PRIVATE_AUTH_GITHUB_CLIENT_SECRET=""
# LinkedIn OAuth client id for Better Auth (from LinkedIn Developer Portal → your app)
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_ID=""
# LinkedIn OAuth client secret for Better Auth (from LinkedIn Developer Portal)
BONDERY_PRIVATE_AUTH_LINKEDIN_CLIENT_SECRET=""
# Better Auth versioned secrets (format: version:secret[,version:secret...]; highest version first)
# Generate: openssl rand -hex 32 — then set as 1:<output>
BONDERY_PRIVATE_BETTER_AUTH_SECRETS=1:your-super-secret-better-auth-secret-min-32-chars
# Webapp's own OAuth client secret (never exposed to the browser). The API only ever stores/verifies its hash via deployment-time provisioning; it never round-trips the plaintext value.
# Generate: openssl rand -hex 32
BONDERY_PRIVATE_WEBAPP_OAUTH_CLIENT_SECRET=""
# Chrome extension OAuth client id. Also consumed by the API's deployment-time OAuth client provisioning.
# Generate: openssl rand -hex 16
BONDERY_PUBLIC_OAUTH_CLIENT_ID=""
# Webapp's own OAuth client id (confidential BFF client of the API's oauth-provider)
# Generate: openssl rand -hex 16
BONDERY_PUBLIC_WEBAPP_OAUTH_CLIENT_ID=""

# --- Database ---
# Generate a Postgres password:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32   # BONDERY_PRIVATE_POSTGRES_PASSWORD
# pnpm run env derives DATABASE_URL for api/db from this password.
# Postgres connection string (Prisma + API)
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@127.0.0.1:54322/bondery

# --- Email ---
# From address for transactional email
BONDERY_PRIVATE_EMAIL_ADDRESS=robot@example.com
# SMTP host
BONDERY_PRIVATE_EMAIL_HOST=smtp.example.com
# SMTP password
BONDERY_PRIVATE_EMAIL_PASS=your-email-password
# SMTP port
BONDERY_PRIVATE_EMAIL_PORT=587
# Reply-To address for automated transactional email
BONDERY_PRIVATE_EMAIL_REPLY_TO=team@usebondery.com
# SMTP username
BONDERY_PRIVATE_EMAIL_USER=robot@example.com

# --- Infra ---
# Chrome Web Store extension ID. Derives the https://{id}.chromiumapp.org/ OAuth redirect URI and allows chrome-extension://{id} CORS on the authorization server.
BONDERY_INFRA_CHROME_EXTENSION_ID=lpcmokfekjjejnpobhbkgmjkodfhpmha
# Git SHA surfaced in runtime config and health probes
BONDERY_INFRA_GIT_SHA=""
# Image tag for api and webapp: production CalVer pin (X.Y.Z), or omit for floating `:production`. Staging Dokploy may pin a named RC (`X.Y.Z-rc.N`) or floating `:beta` (RC cuts only). RC is not a self-host channel.
BONDERY_INFRA_VERSION=""

# --- Local dev (API) ---
# When true, skip release-migrate (prisma deploy + functions.sql + OAuth + platform admins) on API dev boot
BONDERY_DEV_SKIP_RELEASE_MIGRATE=""
# When true, skip SeaweedFS bucket ensure on API dev boot
BONDERY_DEV_SKIP_STORAGE_BUCKETS=""

# --- Maps ---
# Mapy.com API key
BONDERY_PRIVATE_MAPS_KEY=<your-maps-api-key>
# Mapy.com API base URL
BONDERY_PUBLIC_MAPS_URL=https://api.mapy.com

# --- Public URLs ---
# Public API base URL (no trailing /api)
BONDERY_PUBLIC_API_URL=http://localhost:26631
# Comma-separated extra CORS origins (e.g. Expo web)
BONDERY_PUBLIC_EXTRA_ALLOWED_ORIGINS=http://localhost:26634
# Public webapp origin
BONDERY_PUBLIC_WEBAPP_URL=http://localhost:26632
# Optional WebAuthn rpID override for self-host DNS that does not match the cookie parent domain. Do not set for hosted Bondery. Never an IP.
BONDERY_PUBLIC_WEBAUTHN_RP_ID=""
# Public marketing website origin
BONDERY_PUBLIC_WEBSITE_URL=http://localhost:26630

# --- Redis ---
# Redis connection URL
BONDERY_PRIVATE_REDIS_URL=redis://127.0.0.1:26636

# --- Storage ---
# Local dev: bundled SeaweedFS defaults below are fine.
# Production secret key: openssl rand -hex 32   # BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY
# Public hostname for SeaweedFS S3 (Traefik Host rule in compose).
BONDERY_INFRA_STORAGE_DOMAIN=storage.usebondery.com
# SeaweedFS S3 access key id (API client + rendered into seaweedfs-s3 at startup).
BONDERY_PRIVATE_S3_ACCESS_KEY_ID=bondery_access_key
# SeaweedFS S3 gateway URL (local dev: 127.0.0.1; Compose: http://seaweedfs-s3:8333).
BONDERY_PRIVATE_S3_ENDPOINT=http://127.0.0.1:8333
# S3 region accepted by SeaweedFS (any value).
BONDERY_PRIVATE_S3_REGION=eu-central-1
# SeaweedFS S3 secret access key (API client + rendered into seaweedfs-s3 at startup). Local dev: any string; production: openssl rand -hex 32
BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY=bondery_secret_key_change_me
# Public base URL for SeaweedFS S3 objects (no trailing slash).
BONDERY_PUBLIC_STORAGE_URL=http://127.0.0.1:8333

# --- Stripe ---
# Stripe API secret key
BONDERY_PRIVATE_STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
# Stripe webhook signing secret
BONDERY_PRIVATE_STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>
# Enable in-app subscription upgrades (true | false)
BONDERY_PUBLIC_BILLING_UPGRADES_ENABLED=false
# Stripe Price ID for annual Premium
BONDERY_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_<annual>
# Stripe Price ID for monthly Premium
BONDERY_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_<monthly>
# Stripe publishable key for embedded Checkout
BONDERY_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

