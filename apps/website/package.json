  "description": "Bondery Website",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "^10.1.0",
    "github-slugger": "^2.0.0",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.24",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
