    "i18next": "^26.4.2",
    "lucide-react": "1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-i18next": "^16.3.0",
    "next-plausible": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
