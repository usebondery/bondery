    "eas-build-cache-provider": "^23.0.0",
    "expo-mcp": "~0.2.4",
    "react-refresh": "^0.18.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "react",
        "react-dom",
        "typescript"
      ]
    }
  },
  "main": "expo-router/entry",
  "name": "mobile",
  "private": true,
  "scripts": {
    "android:dev": "pnpm run generate-icons && node ../../scripts/dev/ensure-java-home.mjs expo run:android --device",
    "android:pair": "adb pair",
    "audit:forms": "tsx scripts/audit-mobile-forms.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:sync-patterns": "tsx scripts/check-sync-patterns.ts",
    "check:types": "node ../../scripts/dev/tsc-native.mjs --noEmit",
    "dev": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --port 26634",
    "dev:prebuild": "pnpm run generate-icons && pnpm exec expo prebuild --clean",
    "dev:tunnel": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 expo start --port 26634 --tunnel",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "ios": "expo run:ios",
    "predev": "pnpm run generate-icons",
    "predev:tunnel": "pnpm run generate-icons",
    "test:api": "tsx --test src/lib/api/*.test.ts",
    "test:auth": "tsx --test src/lib/auth/*.test.ts",
    "test:navigation": "tsx --test src/lib/navigation/*.test.ts",
    "test:sync": "tsx --test src/lib/sync/**/*.test.ts"
  },
  "version": "1.11.0-rc.1"
}
