# Generated by pnpm run env — do not edit by hand. Edit root .env.local instead.

# --- Mobile ---
# Web local issuer is Portless HTTPS (*.usebondery.test).
# Device/emulator may still use loopback raw ports below.
# Mobile sync debug logging (1/true)
BONDERY_PUBLIC_SYNC_DEBUG=""

# --- Public URLs ---
# Local web stack uses Portless HTTPS (website/webapp/api).
# Webapp SSR: set BONDERY_INFRA_INTERNAL_API_URL=http://127.0.0.1:26631 (browser still uses the public API URL).
# Public API base URL (no trailing /api)
BONDERY_PUBLIC_API_URL=http://localhost:26631
# Public webapp origin
BONDERY_PUBLIC_WEBAPP_URL=http://localhost:26632
# Public marketing website origin
BONDERY_PUBLIC_WEBSITE_URL=http://localhost:26630

# --- Storage ---
# Local dev: bundled SeaweedFS defaults below are fine.
# Production secret key: openssl rand -hex 32   # BONDERY_PRIVATE_S3_SECRET_ACCESS_KEY
# Public base URL for SeaweedFS S3 objects (no trailing slash).
BONDERY_PUBLIC_STORAGE_URL=http://127.0.0.1:8333

