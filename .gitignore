# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/web

# Playwright auth storage (local sessions)
apps/webapp/e2e/.auth/

# testing
/coverage
**/test-results/
**/playwright-report/
**/blob-report/

# next.js
**/.next/
/out/

# production
/build
**/dist/

# i18next-cli ephemeral locale mirror (canonical files stay nested under src/locales)
packages/translations/.i18next-cli-mirror/

# misc
.DS_Store
*.pem
lefthook-local.yml

# wxt
/.wxt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.production.local
.env.development.local
.env
.env.production
.env.local

# vercel
.vercel
**/.vercel/output


# typescript
*.tsbuildinfo
.cache/
next-env.d.ts

# turborepo
.turbo

# Generated API reference MDX (build-time from OpenAPI spec)
docs/api/api-reference/_generated/

# Temporary backup of local env files (manual migration / testing)
.tmp-env-backup/

# Local scratch (CWS listing PNG export, etc.)
/tmp/

#ngrok
ngrok.yml
ngrok1.yml
ngrok2.yml
ngrok3.yml
.cursor/mcp.json
.supabase-export/

# MCP Inspector writable catalog (seeded from scripts/dev/mcp-inspector.json)
scripts/dev/mcp-inspector.local.json
