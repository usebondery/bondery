// Rejects == / === / != / !== on secret values (service secrets, webhook
// secrets, signatures, HMACs, passwords, API keys, bearer tokens).
// A plain string compare returns at the first differing byte, so the response
// time can leak how much of a guessed secret is correct. Use
// constantTimeEqual() from apps/api/src/lib/platform/security/constant-time-equal.ts.
//
// A value is secret when its name (or the last segment of a member access)
// says so, or when it is a `const` in the same file that is initialised
// from such a name. Compares against literals (null, undefined, "", numbers)
// are presence checks and do not leak the value.

language js

pattern secret_word() {
  r"(?i)^[\w$]*(?:secret|signature|hmac|password|apikey|api_key|(?:access|refresh|bearer|session|csrf|auth|service|reset|verification)_?token)[\w$]*$"
}

// The last segment of a member access, e.g. fastify.config.BONDERY_PRIVATE_SERVICE_SECRET.
pattern secret_member() {
  JsStaticMemberExpression(member=$member) where { $member <: secret_word() }
}

// A local name. SCREAMING_CASE locals are module constants, not secrets
// (secrets come from config or env), and has*/is* names are booleans.
pattern secret_identifier() {
  JsIdentifierExpression() as $id where {
    $id <: secret_word(),
    not $id <: r"^[A-Z0-9_$]+$",
    not $id <: r"^(?:has|is|should|can)[A-Z_][\w$]*$"
  }
}

pattern secret_name() {
  or {
    secret_member(),
    secret_identifier()
  }
}

pattern literal_value() {
  or {
    JsStringLiteralExpression(),
    JsNumberLiteralExpression(),
    JsBooleanLiteralExpression(),
    JsNullLiteralExpression(),
    JsTemplateExpression(),
    `undefined`
  }
}

pattern secret_value($file) {
  or {
    secret_name(),
    JsIdentifierExpression() as $name where {
      $file <: contains `const $name = $init` where { $init <: secret_name() }
    }
  }
}

or {
  `$left === $right`,
  `$left !== $right`,
  `$left == $right`,
  `$left != $right`
} as $cmp where {
  // Client apps and dev scripts have no remote caller to time a compare.
  $filename <: not r"(?:.*\W)?(?:apps\W(?:mobile|chrome-extension)|scripts)\W.*",
  $cmp <: within JsModule() as $file,
  not $left <: literal_value(),
  not $right <: literal_value(),
  or { $left <: secret_value($file), $right <: secret_value($file) },
  register_diagnostic(span=$cmp, message="Do not compare secrets, signatures or tokens with == or ===. Use constantTimeEqual() so the compare time does not leak the value.", severity="error")
}
