{
  "browserslist": {
    "development": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 140",
      "safari >= 18.4",
      "ios_saf >= 18.4"
    ],
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 140",
      "safari >= 18.4",
      "ios_saf >= 18.4",
      "and_chr >= 111"
    ]
  },
  "dependencies": {
    "freeport-async": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@bondery/helpers": "workspace:*",
    "@bondery/schemas": "workspace:*",
    "@redocly/cli": "^2.51.2",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "26"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12.4.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "name": "bondery-monorepo",
  "packageManager": "pnpm@12.4.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:chrome-extension": "turbo build --filter=chrome-extension",
    "build:mobile": "turbo build --filter=mobile",
    "build:packages": "turbo compile --filter=./packages/*",
    "build:translations": "turbo build --filter=@bondery/translations",
    "build:webapp": "turbo build --filter=webapp",
    "build:website": "turbo build --filter=website",
    "check": "biome ci . && pnpm run check:package-imports && pnpm run env:check && pnpm run check:env && pnpm run check:docs && pnpm run check:openapi && pnpm run test:webapp:runtime-config && pnpm run check:contracts && pnpm run check:types && pnpm run check:i18n && pnpm run check:api-errors && pnpm run test:api:sync",
    "check:api-errors": "pnpm run check:api-errors:catalog && pnpm run check:api-errors:translations && pnpm run check:api-errors:client-display",
    "check:api-errors:catalog": "node scripts/check/check-api-errors-catalog.mjs",
    "check:api-errors:client-display": "node scripts/check/check-api-errors-client-display.mjs",
    "check:api-errors:translations": "node scripts/check/check-api-errors-translations.mjs",
    "check:contracts": "pnpm --filter @bondery/schemas run check:contracts",
    "check:docs": "pnpm run check:docs:links && pnpm run check:docs:mdx",
    "check:docs:links": "node scripts/check/check-docs-links.mjs",
    "check:docs:mdx": "pnpm --filter website run check:docs:mdx",
    "check:env": "turbo run check:env --concurrency=1",
    "check:extension-patterns": "pnpm --filter chrome-extension run check:extension-patterns",
    "check:i18n": "pnpm run check:i18n:structure && pnpm run check:i18n:types && pnpm run check:i18n:usage && pnpm run check:i18n:lint",
    "check:i18n:lint": "pnpm --filter @bondery/translations run check:i18n:lint",
    "check:i18n:structure": "node packages/translations/scripts/check-i18n-structure.mjs",
    "check:i18n:types": "pnpm --filter @bondery/translations run check:i18n:types",
    "check:i18n:usage": "pnpm --filter @bondery/translations run check:i18n:usage",
    "check:openapi": "pnpm --filter api run check:openapi-spec && pnpm exec redocly lint packages/openapi-spec/openapi.yaml",
    "check:package-imports": "node scripts/check/check-package-imports.mjs",
    "check:sync-patterns": "pnpm --filter mobile run check:sync-patterns",
    "check:types": "turbo check:types",
    "check:versions": "node scripts/check/check-versions.mjs",
    "db:functions": "pnpm --filter @bondery/db run db:functions",
    "db:generate": "pnpm --filter @bondery/db run db:generate",
    "db:migrate:deploy": "pnpm --filter @bondery/db run db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @bondery/db run db:migrate:dev",
    "db:studio": "pnpm --filter @bondery/db run db:studio",
    "db:validate": "pnpm --filter @bondery/db run db:validate",
    "dev": "turbo run dev --concurrency 20",
    "dev:api": "turbo run api#dev --concurrency 20",
    "dev:chrome-extension": "turbo run chrome-extension#dev --concurrency 20",
    "dev:emails": "turbo run @bondery/emails#preview --concurrency 20",
    "dev:extension": "turbo run webapp#dev api#dev chrome-extension#dev website#dev --concurrency 20",
    "dev:mobile": "turbo run api#dev mobile#dev --concurrency 20",
    "dev:stripe": "node --import tsx scripts/ops/dev-stripe.ts",
    "dev:webapp": "turbo run webapp#dev --concurrency 20",
    "dev:webapp-api": "turbo run webapp#dev api#dev --concurrency 20",
    "dev:webapp-api-emails": "turbo run webapp#dev api#dev @bondery/emails#preview --concurrency 20",
    "dev:website": "turbo run website#dev --concurrency 20",
    "env": "node --import tsx scripts/env/env.ts --all",
    "env:check": "pnpm --filter @bondery/helpers run build && node --import tsx scripts/env/env.ts --check",
    "env:development": "node --import tsx scripts/env/env.ts --development",
    "env:examples": "node scripts/env/generate-env-examples.mjs",
    "env:production": "node --import tsx scripts/env/env.ts --production",
    "env:pull": "node --import tsx scripts/env/env-pull.ts",
    "env:sync": "node scripts/env/env-sync.mjs",
    "generate:doc-links": "node scripts/pkg/generate-doc-links.mjs",
    "generate:openapi": "turbo generate:openapi --filter=api",
    "github:repo-settings": "bash .github/scripts/apply-repo-settings.sh",
    "github:rulesets": "bash .github/scripts/apply-rulesets.sh",
    "hooks:biome": "node scripts/check/run-pre-commit-biome.mjs",
    "hooks:run": "lefthook run pre-commit",
    "i18n:status": "pnpm --filter @bondery/translations run i18n:status",
    "i18n:types": "pnpm --filter @bondery/translations run i18n:types",
    "kill:dev": "node scripts/dev/kill-dev-servers.mjs",
    "lint": "biome check --write .",
    "prepare": "lefthook install --reset-hooks-path",
    "provision:oauth-clients": "pnpm --filter api run provision-oauth-clients:dev",
    "provision:platform-admins": "pnpm --filter api run provision-platform-admins:dev",
    "release-migrate": "pnpm --filter @bondery/db run release-migrate",
    "setup:dev": "node --import tsx scripts/dev/setup-dev.ts",
    "setup:seaweedfs": "pnpm run build:api && node --env-file=.env.local apps/api/dist/cli/ensure-storage-buckets.js",
    "setup:stripe": "node --import tsx scripts/ops/setup-stripe.ts",
    "start:apps": "turbo start",
    "start:postgres": "docker compose -f deploy/bondery/docker-compose.dev-db.yml --env-file .env.local up -d",
    "start:redis": "docker compose -f deploy/bondery/docker-compose.dev-redis.yml up -d",
    "start:seaweedfs": "docker compose -f deploy/bondery/docker-compose.seaweedfs.yml -f deploy/bondery/docker-compose.seaweedfs.dev.yml --env-file .env.local up -d",
    "stop:postgres": "docker compose -f deploy/bondery/docker-compose.dev-db.yml --env-file .env.local down",
    "stop:redis": "docker compose -f deploy/bondery/docker-compose.dev-redis.yml down",
    "stop:seaweedfs": "docker compose -f deploy/bondery/docker-compose.seaweedfs.yml -f deploy/bondery/docker-compose.seaweedfs.dev.yml --env-file .env.local down",
    "sync-exports": "node scripts/pkg/sync-package-exports.mjs",
    "sync-version": "node scripts/pkg/sync-version.mjs",
    "test:api": "pnpm --filter api run test:api",
    "test:api:sync": "pnpm --filter api run test:sync",
    "test:auth": "pnpm --filter api run test:auth",
    "test:mobile:sync": "pnpm --filter mobile run test:sync",
    "test:webapp:runtime-config": "pnpm --filter webapp run test:runtime-config",
    "test:webapp:sync": "pnpm --filter webapp run test:sync",
    "test:webapp:theme": "pnpm --filter webapp run test:theme",
    "tsc-native": "node scripts/dev/tsc-native.mjs",
    "turbo:clean": "turbo daemon clean",
    "update:aaguid-catalog": "node --import tsx scripts/updater/refresh-aaguid-catalog.ts"
  },
  "version": "1.9.2-rc.1"
}
