{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "preset": "all"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/.parcel-cache",
      "!**/next-env.d.ts",
      "!**/uniwind-types.d.ts",
      "!**/*.svg",
      "!**/Untitled-1.html",
      "!**/*.generated.ts",
      "!**/generated",
      "!packages/schemas/src/openapi/fixtures",
      "!.temp",
      "!**/.dockerignore*",
      "!**/.cursor",
      "!**/.source",
      "!.claude/agents",
      "!.claude/skills",
      "!.mcp.json",
      "!.agents/skills/*",
      ".agents/skills/bondery-*",
      "!llm-plugins/claude",
      "!llm-plugins/openai",
      "!packages/openapi-spec/openapi.yaml",
      "!apps/webapp/src/lib/auth/aaguid-catalog/aaguid.json",
      "!apps/webapp/src/lib/auth/aaguid-catalog/better-auth-authenticator-names.json",
      "!apps/webapp/e2e/probe-tmp",
      "!apps/webapp/e2e/__audit-*"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["__DEV__"]
  },
  "linter": {
    "domains": {
      "next": "all",
      "playwright": "all",
      "project": "all",
      "react": "all",
      "tailwind": "all",
      "tanstackQuery": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "noAmbiguousAnchorText": "error",
        "noNoninteractiveElementInteractions": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noArguments": "error",
        "noDivRegex": "error",
        "noExcessiveCognitiveComplexity": "info",
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 70
          }
        },
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noRedundantDefaultExport": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatchBinding": "error",
        "noUselessFragments": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "noUselessUndefinedInitialization": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useDateNow": "error",
        "useIndexOf": "error",
        "useMathMinMax": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 5
          }
        },
        "useOptionalChain": "error",
        "useRegexpTest": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noChildrenProp": "error",
        "noDuplicateArgumentNames": "error",
        "noDuplicateEnumValueNames": "error",
        "noDuplicateFieldDefinitionNames": "error",
        "noDuplicateInputFieldNames": "error",
        "noDuplicateVariableNames": "error",
        "noGlobalDirnameFilename": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noPlaywrightMissingAwait": "error",
        "noPrivateImports": "error",
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "off",
        "noUnusedInstantiation": "error",
        "noUnusedVariables": "error",
        "useGraphqlNamedOperations": "error",
        "useImportExtensions": "off",
        "useInlineScriptId": "error",
        "useJsonImportAttributes": "error",
        "useLoneAnonymousOperation": "error",
        "useSingleJsDocAsterisk": "error",
        "useUniqueElementIds": "error"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noAsyncPromiseFinally": "error",
        "noAwaitInPromiseMethods": "error",
        "noBaseToString": "error",
        "noBooleanSortComparator": "error",
        "noBufferConstructor": "error",
        "noChainedComparison": "error",
        "noConstantComparisons": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noDuplicateTypeConstituents": "error",
        "noDynamicDelete": "error",
        "noDynamicRequire": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noExcessiveNestedBlocks": "info",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidFetchOptions": "error",
        "noInvalidRemoveEventListener": "error",
        "noInvalidThis": "error",
        "noJsRestrictedProperties": "error",
        "noLateCurrentTargetAccess": "error",
        "noLateEventControl": "error",
        "noMapSpread": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMismatchedMapKey": "error",
        "noMissingThrow": "error",
        "noMisusedPromises": "error",
        "noMisusedSpread": "error",
        "noNegatedArrayPredicate": "error",
        "noNegationInEqualityCheck": "error",
        "noNestedTemplateLiterals": "error",
        "noNewArray": "error",
        "noNonScalableViewport": "error",
        "noNumberArgumentOutOfRange": "error",
        "noObjectLiteralComparison": "error",
        "noObsoleteAttributes": "error",
        "noObsoleteTags": "error",
        "noPathConcat": "error",
        "noPlaywrightNthMethods": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noReactDirectStateMutation": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noRedundantTypeConstituents": "error",
        "noRestrictedDependencies": "error",
        "noReturnArrayPush": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noSharedBranchCode": "error",
        "noSinglePromiseInPromiseMethods": "error",
        "noTailwindArbitraryValue": "error",
        "noTailwindLegacyUtilities": "error",
        "noTailwindRawColors": "error",
        "noTailwindRestrictedClasses": "error",
        "noTailwindRestyledComponents": {
          "level": "error",
          "options": {
            "allow": [
              {
                "categories": ["color", "effects", "motion", "shape", "spacing", "typography"],
                "components": [
                  "ActivityIndicator",
                  "Animated",
                  "Body",
                  "Column",
                  "Container",
                  "FlatList",
                  "Head",
                  "Hr",
                  "Html",
                  "Image",
                  "Img",
                  "KeyboardAvoidingView",
                  "Link",
                  "Modal",
                  "Preview",
                  "Pressable",
                  "RefreshControl",
                  "Row",
                  "SafeAreaView",
                  "ScrollView",
                  "Section",
                  "SectionList",
                  "Switch",
                  "Text",
                  "TextInput",
                  "TouchableOpacity",
                  "View",
                  "motion"
                ]
              }
            ]
          }
        },
        "noTanstackQueryRestDestructuring": "error",
        "noTanstackQueryVoidQueryFn": "error",
        "noThisOutsideOfClass": "error",
        "noUninvokedArrayCallback": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeReturn": "error",
        "noUnsafeTypeAssertion": "off",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessAwait": "error",
        "noUselessCall": "error",
        "noUselessFallbackInSpread": "error",
        "noUselessLengthCheck": "error",
        "noUselessRecursion": "error",
        "noUselessSplice": "error",
        "noUselessSpread": "error",
        "noUselessTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "noYamlBooleanKeys": "error",
        "noYamlEmptyMapKeys": "error",
        "noYamlEmptyMapValues": "error",
        "noYamlEmptySequenceEntries": "error",
        "noZeroFractions": "error",
        "useAtomicUpdates": "error",
        "useAwaitThenable": "error",
        "useCalledWith": "error",
        "useCatchErrorName": "error",
        "useConsistentHeadingLevel": "error",
        "useConsistentUnicodeBom": "error",
        "useControlLabel": "error",
        "useDisposables": "off",
        "useExhaustiveSwitchCases": "error",
        "useExpectToContain": "error",
        "useExpectToHaveBeenCalled": "error",
        "useExpectToHaveBeenCalledTimes": "error",
        "useFencedCodeLanguage": "error",
        "useFlatMathMinMax": "error",
        "useIncludes": "error",
        "useLowercaseTestTitle": "error",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "useNamedFunction": "error",
        "useNextScriptForGoogleAnalytics": "error",
        "useNullishCoalescing": "error",
        "useObjectFromEntries": "error",
        "usePromiseRejectErrors": "error",
        "useReactCompiler": "error",
        "useReactFunctionComponentDefinition": "error",
        "useReactNamingConvention": "off",
        "useRegexpExec": "off",
        "useSetSize": "error",
        "useSimplifiedBooleanReturn": "error",
        "useSingleTopLevelHeading": "error",
        "useSpyOn": "error",
        "useStrictBooleanExpressions": "off",
        "useStringStartsEndsWith": "error",
        "useTailwindShorthandClasses": "error",
        "useTailwindSortedClasses": "error",
        "useTailwindStaticClassStrings": "error",
        "useTailwindVariablesShorthand": "error",
        "useTanstackQueryInfiniteQueryPropertyOrder": "error",
        "useTanstackQueryStableQueryClient": "error",
        "useTopLevelHeading": "error",
        "useValidNamespaceImports": "error",
        "useValidTestTitle": "error"
      },
      "performance": {
        "noAwaitInLoops": "info",
        "noBarrelFile": "info",
        "noImgElement": "error",
        "noJsxPropsBind": "off",
        "noReExportAll": "info",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "error",
        "useGoogleFontPreconnect": "error",
        "useTopLevelRegex": "error"
      },
      "preset": "recommended",
      "security": {
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "useIframeSandbox": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500
          }
        },
        "noExportedImports": "error",
        "noHeadElement": "error",
        "noHexColors": "error",
        "noIncrementDecrement": "error",
        "noInferrableTypes": "error",
        "noJsxLiterals": {
          "level": "error",
          "options": {
            "allowedStrings": [
              "",
              " ",
              "+",
              ",",
              ".",
              ":",
              ";",
              "(",
              ")",
              "=",
              "→",
              "×",
              "1×",
              "·",
              "–",
              "—",
              "/",
              "“",
              "”",
              "@",
              "🤖",
              "🎲"
            ]
          }
        },
        "noMagicNumbers": "info",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightWaitForSelector": "error",
        "noProcessEnv": "info",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "escape": "Use encodeURIComponent.",
              "unescape": "Use decodeURIComponent.",
              "XMLHttpRequest": "Use fetch."
            }
          }
        },
        "noRestrictedTypes": "error",
        "noRootType": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noVueOptionsApi": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useComponentExportOnlyModules": "off",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentArrowReturn": {
          "level": "error",
          "options": {
            "style": "asNeeded"
          }
        },
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentCurlyBraces": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentGraphqlDescriptions": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "noPublic"
          }
        },
        "useConsistentMethodSignatures": {
          "level": "error",
          "options": {
            "style": "property"
          }
        },
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "it",
            "withinDescribe": "it"
          }
        },
        "useDefaultParameterLast": "error",
        "useDeprecatedReason": "error",
        "useDestructuring": "error",
        "useDomQuerySelector": "error",
        "useEnumInitializers": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useExponentiationOperator": "error",
        "useExportsLast": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true
          }
        },
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGraphqlNamingConvention": "error",
        "useGroupedAccessorPairs": "error",
        "useImportsFirst": "error",
        "useInputName": "error",
        "useLoneExecutableDefinition": "error",
        "useNamedCaptureGroup": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "formats": ["PascalCase"],
                "selector": {
                  "kind": "typeParameter"
                }
              },
              {
                "match": "T(.+)",
                "selector": {
                  "kind": "typeParameter"
                }
              },
              {
                "match": ".*"
              }
            ],
            "requireAscii": true,
            "strictCase": false
          }
        },
        "useNodeAssertStrict": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useReadonlyClassProperties": "error",
        "useReduceTypeParameter": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnicodeRegex": "error",
        "useUnifiedTypeSignatures": "error",
        "useVarsOnTop": "error",
        "useVueConsistentDefinePropsDeclaration": "error",
        "useVueDefineMacrosOrder": "error",
        "useVueMultiWordComponentNames": "error",
        "useVueNextTickPromise": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConditionalExpect": "error",
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "warn",
        "noDocumentImportInPage": "error",
        "noDuplicatedSpreadProps": "error",
        "noDuplicateFields": "error",
        "noDuplicateGraphqlOperationName": "error",
        "noDuplicateTestHooks": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noGlobalIsNan": "error",
        "noHeadImportInDocument": "error",
        "noIdenticalTestTitle": "error",
        "noImportCycles": "error",
        "noJsxLeakedDollar": "error",
        "noLeakedRender": "error",
        "noLoopFunc": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noPrototypeBuiltins": "error",
        "noReactForwardRef": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noTemplateCurlyInString": "error",
        "noThenProperty": "error",
        "noUnassignedVariables": "error",
        "noUndeclaredEnvVars": {
          "level": "error",
          "options": {
            "allowedEnvVars": [
              "CI",
              "DEV",
              "DISPLAY",
              "E2E_.*",
              "WXT_.*",
              "BONDERY_PUBLIC_.*",
              "CHECK_.*_STRICT",
              "DEBUG_RUN_ID",
              "NGROK",
              "NO_COLOR",
              "FORCE_COLOR",
              "WAYLAND_DISPLAY"
            ]
          }
        },
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "noUntrustedLicenses": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "info",
        "useBaseline": {
          "level": "error",
          "options": {
            "allowSelectors": ["selection"],
            "available": "newly"
          }
        },
        "useDeprecatedDate": "error",
        "useErrorMessage": "error",
        "useExpect": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "error"
      }
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/mobile/**",
        "apps/webapp/**",
        "apps/website/**",
        "apps/chrome-extension/**",
        "packages/mantine-next/**",
        "packages/emails/**",
        "packages/branding/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useReactNamingConvention": "error"
          }
        }
      }
    },
    {
      "assist": {
        "enabled": false
      },
      "includes": ["**/package.json"]
    },
    {
      "includes": ["apps/**", "packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**", "**/packages/**"],
                    "message": "Import another workspace package by its name (for example @bondery/helpers), never by a relative path into apps/ or packages/."
                  },
                  {
                    "group": ["@bondery/*/src/**", "@bondery/*/dist/**"],
                    "message": "Import the package's public subpath from its exports map, not its src/ or dist/ files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "**/scripts/*",
        "apps/api/src/cli/**",
        "apps/api/src/lib/bootstrap/**",
        "apps/api/src/lib/storage/ensure-buckets.ts",
        "packages/db/src/apply-sql-functions.ts",
        "packages/helpers/src/env/check-env.ts",
        "apps/chrome-extension/wxt.config.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/tests/sample-data/**"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/webapp/typecheck-experiments/**"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/webapp/src/app/(app)/dev/store-shots/**"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/translations/scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "domains": {
          "reactNative": "all"
        },
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          },
          "nursery": {
            "useReactCompiler": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/website/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "error"
          },
          "nursery": {
            "useReactCompiler": "error"
          },
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/website/src/lib/env.ts",
        "apps/website/next.config.ts",
        "apps/website/scripts/**",
        "apps/website/src/app/blog/_lib/server-utils.ts",
        "apps/website/src/app/(marketing)/blog/_lib/server-utils.ts",
        "apps/website/src/app/openapi.yaml/route.ts",
        "apps/website/src/lib/platform/validateWebsiteStartup.node.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/webapp/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          },
          "nursery": {
            "useReactCompiler": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/webapp/src/**"],
      "linter": {
        "rules": {
