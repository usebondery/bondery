{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/dev/setup-worktree.mjs\" --if-needed 1>&2",
            "timeout": 900,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check/claude-stop-hook.mjs\"",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  }
}
