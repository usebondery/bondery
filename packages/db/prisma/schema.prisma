// Bondery Prisma schema — entry file (generator + datasource only).
//
// Models live in prisma/models/*.prisma. Table/column names intentionally match
// the existing Postgres schema so migrations move rows, not rename columns.
// Auth tables follow Better Auth conventions — regenerate with
// `npx @better-auth/cli generate` when the plugin list changes, then reconcile.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
