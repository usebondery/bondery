/// OAuth 2.1 authorization-server tables from Better Auth `mcp()` (oauth-provider
/// superset) + `cimd()`. Field names/shapes were extracted from
/// `getAuthTables(auth.options)` for the locked plugin configuration —
/// see `add_oauth_provider_1_7` and `mcp_oauth_cimd` migration notes.
model OauthClient {
  id                               String    @id @default(uuid()) @db.Uuid
  clientId                         String    @unique @map("client_id")
  clientSecret                     String?   @map("client_secret")
  disabled                         Boolean   @default(false)
  skipConsent                      Boolean?  @map("skip_consent")
  enableEndSession                 Boolean?  @map("enable_end_session")
  subjectType                      String?   @map("subject_type")
  scopes                           String[]
  userId                           String?   @map("user_id") @db.Uuid
  user                             User?     @relation(fields: [userId], references: [id])
  createdAt                        DateTime? @default(now()) @map("created_at")
  updatedAt                        DateTime? @updatedAt @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?   @map("software_id")
  softwareVersion                  String?   @map("software_version")
  softwareStatement                String?   @map("software_statement")
  redirectUris                     String[]  @map("redirect_uris")
  postLogoutRedirectUris           String[]  @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?   @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?  @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?   @map("token_endpoint_auth_method")
  jwks                             String?
  jwksUri                          String?   @map("jwks_uri")
  grantTypes                       String[]  @map("grant_types")
  responseTypes                    String[]  @map("response_types")
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?  @map("require_pkce")
  dpopBoundAccessTokens            Boolean   @default(false) @map("dpop_bound_access_tokens")
  /// CIMD provenance — Better Auth `getAuthTables` field `clientDiscoveryId`
  /// (`"cimd"` for Client ID Metadata Documents). First-party provisioned
  /// clients leave this null.
  clientDiscoveryId                String?   @map("client_discovery_id")
  clientCredentialsScopes          String[]  @default([]) @map("client_credentials_scopes")
  applicationType                  String?   @map("application_type")
  referenceId                      String?   @map("reference_id")
  metadata                         Json?

  clientResources OauthClientResource[]
  refreshTokens   OauthRefreshToken[]
  accessTokens    OauthAccessToken[]
  consents        OauthConsent[]

  @@map("oauth_client")
}

model OauthResource {
  id                            String    @id @default(uuid()) @db.Uuid
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?      @map("access_token_ttl")
  refreshTokenTtl               Int?      @map("refresh_token_ttl")
  signingAlgorithm               String?   @map("signing_algorithm")
  signingKeyId                  String?   @map("signing_key_id")
  allowedScopes                 String[]  @map("allowed_scopes")
  customClaims                  Json?     @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean   @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean   @default(false)
  createdAt                     DateTime? @default(now()) @map("created_at")
  updatedAt                     DateTime? @updatedAt @map("updated_at")
  policyVersion                 Int       @default(1) @map("policy_version")
  metadata                      Json?

  clientResources OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(uuid()) @db.Uuid
  clientId   String        @map("client_id")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now()) @map("created_at")

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String    @id @default(uuid()) @db.Uuid
  token                   String    @unique
  clientId                String    @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId])
  sessionId               String?   @map("session_id") @db.Uuid
  session                 Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?   @map("reference_id")
  authorizationCodeId     String?   @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  expiresAt               DateTime? @map("expires_at")
  createdAt               DateTime? @default(now()) @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime? @map("rotated_at")
  rotationReplayResponse  String?   @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at")
  authTime                DateTime? @map("auth_time")
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(uuid()) @db.Uuid
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId])
  sessionId               String?            @map("session_id") @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id") @db.Uuid
  user                    User?              @relation(fields: [userId], references: [id])
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id") @db.Uuid
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id])
  expiresAt               DateTime?          @map("expires_at")
  createdAt               DateTime?          @default(now()) @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(uuid()) @db.Uuid
  clientId                String      @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId])
  userId                  String?     @map("user_id") @db.Uuid
  user                    User?       @relation(fields: [userId], references: [id])
  referenceId             String?     @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[]    @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime?   @default(now()) @map("created_at")
  updatedAt               DateTime?   @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

/// Replay-protection ledger for signed client-assertion JWTs (private_key_jwt
/// / client_secret_jwt). No foreign keys — Better Auth only tracks the
/// assertion's expiry to bound the anti-replay window.
model OauthClientAssertion {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertion")
}
