{
  "dependencies": {
    "@bondery/schemas": "workspace:*",
    "@react-email/ui": "^6.9.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "fastify-zod-openapi": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-i18next": "^17.0.13",
    "tsx": "^4.23.1"
  },
  "description": "Bondery internationalization translations",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "i18next-cli": "^1.73.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./*": {
      "default": "./dist/*.js",
      "import": "./dist/*.js",
      "node": "./dist/*.js",
      "types": "./src/*.ts"
    },
    "./*.json": {
      "default": "./dist/*.json"
    },
    "./config": {
      "default": "./dist/config.js",
      "import": "./dist/config.js",
      "node": "./dist/config.js",
      "types": "./src/config.ts"
    },
    "./generated/i18n/catalog-prefixes": {
      "default": "./dist/generated/i18n/catalog-prefixes.js",
      "import": "./dist/generated/i18n/catalog-prefixes.js",
      "node": "./dist/generated/i18n/catalog-prefixes.js",
      "types": "./src/generated/i18n/catalog-prefixes.ts"
    },
    "./generated/i18n/catalog-types": {
      "default": "./dist/generated/i18n/catalog-types.js",
      "import": "./dist/generated/i18n/catalog-types.js",
      "node": "./dist/generated/i18n/catalog-types.js",
      "types": "./src/generated/i18n/catalog-types.ts"
    },
    "./generated/i18n/namespaces": {
      "default": "./dist/generated/i18n/namespaces.js",
      "import": "./dist/generated/i18n/namespaces.js",
      "node": "./dist/generated/i18n/namespaces.js",
      "types": "./src/generated/i18n/namespaces.ts"
    },
    "./generated/i18next-cli/i18next.d": {
      "default": "./dist/generated/i18next-cli/i18next.d.js",
      "import": "./dist/generated/i18next-cli/i18next.d.js",
      "node": "./dist/generated/i18next-cli/i18next.d.js",
      "types": "./src/generated/i18next-cli/i18next.d.ts"
    },
    "./generated/i18next-cli/resources.d": {
      "default": "./dist/generated/i18next-cli/resources.d.js",
      "import": "./dist/generated/i18next-cli/resources.d.js",
      "node": "./dist/generated/i18next-cli/resources.d.js",
      "types": "./src/generated/i18next-cli/resources.d.ts"
    },
    "./generated/resources": {
      "default": "./dist/generated/resources.js",
      "import": "./dist/generated/resources.js",
      "node": "./dist/generated/resources.js",
      "types": "./src/generated/resources.ts"
    },
    "./i18n": {
      "default": "./dist/i18n.js",
      "import": "./dist/i18n.js",
      "node": "./dist/i18n.js",
      "types": "./src/i18n.ts"
    },
    "./i18n-types": {
      "default": "./dist/i18n-types.js",
      "import": "./dist/i18n-types.js",
      "node": "./dist/i18n-types.js",
      "types": "./src/i18n-types.ts"
    },
    "./i18next-catalog-augment": {
      "default": "./dist/i18next-catalog-augment.js",
      "import": "./dist/i18next-catalog-augment.js",
      "node": "./dist/i18next-catalog-augment.js",
      "types": "./src/i18next-catalog-augment.ts"
    },
    "./json-modules.d": {
      "default": "./dist/json-modules.d.js",
      "import": "./dist/json-modules.d.js",
      "node": "./dist/json-modules.d.js",
      "types": "./src/json-modules.d.ts"
    },
    "./load-source": {
      "default": "./dist/load-source.js",
      "import": "./dist/load-source.js",
      "node": "./dist/load-source.js",
      "types": "./src/load-source.ts"
    },
    "./loader": {
      "default": "./dist/loader.js",
      "import": "./dist/loader.js",
      "node": "./dist/loader.js",
      "types": "./src/loader.ts"
    },
    "./manifest": {
      "default": "./dist/manifest.js",
      "import": "./dist/manifest.js",
      "node": "./dist/manifest.js",
      "types": "./src/manifest.ts"
    }
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "imports": {
    "#*": [
      "./dist/*",
      "./dist/*.js",
      "./dist/*/index.js",
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "main": "./dist/index.js",
  "name": "@bondery/translations",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-locale-mirror.mjs && node scripts/run-i18next-cli.mjs types && node scripts/generate-resource-map.mjs && node scripts/generate-i18n-catalog.mjs && node scripts/generate-client-i18n-hooks.mjs && rimraf dist tsconfig.tsbuildinfo && tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs translations && node scripts/copy-json.mjs && node scripts/validate-manifest.mjs",
    "check:i18n:lint": "node scripts/run-i18next-cli.mjs lint --quiet",
    "check:i18n:types": "node scripts/run-i18next-cli.mjs types --ci",
    "check:i18n:usage": "node scripts/check-i18n-usage.mjs",
    "check:types": "tsc --noEmit",
    "compile": "node scripts/sync-locale-mirror.mjs && node scripts/generate-resource-map.mjs && tsc && node scripts/copy-json.mjs",
    "dev": "node scripts/dev.mjs",
    "i18n:inlang": "node scripts/generate-inlang-settings.mjs",
    "i18n:status": "node scripts/sync-locale-mirror.mjs && node scripts/run-i18next-cli.mjs status",
    "i18n:types": "node scripts/run-i18next-cli.mjs types"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.9.2-rc.1"
}
