  "imports": {
    "#*": [
      "./dist/*",
      "./dist/*.js",
      "./dist/*/index.js",
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "main": "./dist/index.js",
  "name": "@bondery/vcard",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/pkg/clean-dist.mjs dist tsconfig.tsbuildinfo .cache && tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs vcard",
    "check:types": "tsc --noEmit",
    "compile": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "tsx --test src/**/*.test.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.11.5"
}
