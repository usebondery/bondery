  "files": [
    "dist",
    "src",
    "scripts",
    "src/assets"
  ],
  "imports": {
    "#*": [
      "./dist/*",
      "./dist/*.js",
      "./dist/*/index.js",
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "main": "./dist/index.js",
  "name": "@bondery/branding",
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "scripts": {
    "build": "node ../../scripts/pkg/clean-dist.mjs dist tsconfig.tsbuildinfo .cache && tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs branding && node scripts/copy-brand-assets.mjs",
    "check:types": "tsc --noEmit",
    "compile": "tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs branding && node scripts/copy-brand-assets.mjs",
    "dev": "node ../../scripts/pkg/tsc-watch-and-rewrite.mjs branding",
    "generate:brand-marks": "tsx scripts/generate-brand-marks.ts",
    "generate:brand-icons": "tsx scripts/generate-brand-icons.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.11.5-rc.1"
