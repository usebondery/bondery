  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs branding",
    "compile": "tsc",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.9.2-rc.2"
}
