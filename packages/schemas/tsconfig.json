{
  "compilerOptions": {
    // Zod schemas are composed with .extend/.pick/.shape. Annotating them as
    // z.ZodType<T> for isolatedDeclarations would collapse those APIs.
    "isolatedDeclarations": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "dist", "src/contracts.assertions.ts", "src/**/*.test.ts"],
  "extends": "@bondery/typescript-config/base.json",
  "include": ["src/**/*"]
}
