{
  "dependencies": {
    "@bondery/branding": "workspace:*",
    "@bondery/helpers": "workspace:*",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "^6.9.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4"
  },
  "description": "Bondery email templates using React Email",
  "devDependencies": {
    "@bondery/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./*": {
      "default": "./dist/*.js",
      "import": "./dist/*.js",
      "node": "./dist/*.js",
      "types": "./src/*.ts"
    },
    "./fixtures/default-copy": {
      "default": "./dist/fixtures/default-copy.js",
      "import": "./dist/fixtures/default-copy.js",
      "node": "./dist/fixtures/default-copy.js",
      "types": "./src/fixtures/default-copy.ts"
    },
    "./shared/EmailBody": {
      "default": "./dist/shared/EmailBody.js",
      "import": "./dist/shared/EmailBody.js",
      "node": "./dist/shared/EmailBody.js",
      "types": "./src/shared/EmailBody.tsx"
    },
    "./shared/EmailCta": {
      "default": "./dist/shared/EmailCta.js",
      "import": "./dist/shared/EmailCta.js",
      "node": "./dist/shared/EmailCta.js",
      "types": "./src/shared/EmailCta.tsx"
    },
    "./shared/EmailWrapper": {
      "default": "./dist/shared/EmailWrapper.js",
      "import": "./dist/shared/EmailWrapper.js",
      "node": "./dist/shared/EmailWrapper.js",
      "types": "./src/shared/EmailWrapper.tsx"
    },
    "./templates/account/AccountDeletedEmail": {
      "default": "./dist/templates/account/AccountDeletedEmail.js",
      "import": "./dist/templates/account/AccountDeletedEmail.js",
      "node": "./dist/templates/account/AccountDeletedEmail.js",
      "types": "./src/templates/account/AccountDeletedEmail.tsx"
    },
    "./templates/account/MagicLinkEmail": {
      "default": "./dist/templates/account/MagicLinkEmail.js",
      "import": "./dist/templates/account/MagicLinkEmail.js",
      "node": "./dist/templates/account/MagicLinkEmail.js",
      "types": "./src/templates/account/MagicLinkEmail.tsx"
    },
    "./templates/account/WelcomeEmail": {
      "default": "./dist/templates/account/WelcomeEmail.js",
      "import": "./dist/templates/account/WelcomeEmail.js",
      "node": "./dist/templates/account/WelcomeEmail.js",
      "types": "./src/templates/account/WelcomeEmail.tsx"
    },
    "./templates/billing/TrialEndingEmail": {
      "default": "./dist/templates/billing/TrialEndingEmail.js",
      "import": "./dist/templates/billing/TrialEndingEmail.js",
      "node": "./dist/templates/billing/TrialEndingEmail.js",
      "types": "./src/templates/billing/TrialEndingEmail.tsx"
    },
    "./templates/internal/FeedbackEmail": {
      "default": "./dist/templates/internal/FeedbackEmail.js",
      "import": "./dist/templates/internal/FeedbackEmail.js",
      "node": "./dist/templates/internal/FeedbackEmail.js",
      "types": "./src/templates/internal/FeedbackEmail.tsx"
    },
    "./templates/notifications/ReminderDigestEmail": {
      "default": "./dist/templates/notifications/ReminderDigestEmail.js",
      "import": "./dist/templates/notifications/ReminderDigestEmail.js",
      "node": "./dist/templates/notifications/ReminderDigestEmail.js",
      "types": "./src/templates/notifications/ReminderDigestEmail.tsx"
    },
    "./templates/notifications/ShareContactEmail": {
      "default": "./dist/templates/notifications/ShareContactEmail.js",
      "import": "./dist/templates/notifications/ShareContactEmail.js",
      "node": "./dist/templates/notifications/ShareContactEmail.js",
      "types": "./src/templates/notifications/ShareContactEmail.tsx"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "imports": {
    "#*": [
      "./dist/*",
      "./dist/*.js",
      "./dist/*/index.js",
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "main": "./dist/index.js",
  "name": "@bondery/emails",
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && node ../../scripts/pkg/rewrite-package-hash-imports-in-dist.mjs emails",
    "compile": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "preview": "email dev --dir ./src/templates --port 26639",
    "test": "tsx --test src/**/*.test.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.9.2-rc.1"
}
